/**
 * @summary Attribute to disable the popup trigger.
 */
export const DATA_POPUP_DISABLED = 'data-popup-disabled';

/**
 * @summary Selectors to be used for the popup trigger
 */
export const SELECTORS = {
    popupTrigger: '.js-popup-trigger',
    popupContent: '.js-popup-trigger-content',
};

export default {
    DATA_POPUP_DISABLED,
    SELECTORS,
};
